  "schema_guard": {
    "function": "CREATE OR REPLACE FUNCTION public.fugue_preserve_bound_release_intent()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n IF OLD.revision_workload_json IS NOT NULL AND\n    (NEW.source_ref IS DISTINCT FROM OLD.source_ref OR\n     NEW.resolved_image_ref IS DISTINCT FROM OLD.resolved_image_ref OR\n     NEW.runtime_id IS DISTINCT FROM OLD.runtime_id OR\n     NEW.spec_snapshot_json IS DISTINCT FROM OLD.spec_snapshot_json) THEN\n  RAISE EXCEPTION 'bound revision executable intent is immutable' USING ERRCODE = '40001';\n END IF;\n RETURN NEW;\nEND\n$function$\n",
    "trigger": {
      "name": "fugue_app_release_intent_immutable",
      "enabled": "O",
      "definition": "CREATE TRIGGER fugue_app_release_intent_immutable BEFORE UPDATE ON public.fugue_app_releases FOR EACH ROW EXECUTE FUNCTION fugue_preserve_bound_release_intent()"
    }
